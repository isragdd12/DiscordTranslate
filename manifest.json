{
  "manifest_version": 3,
  "name": "Discord Translator",
  "version": "1.5.1",
  "description": "Translate Discord messages and your input text using.",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["languages.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}

